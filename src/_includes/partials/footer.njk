<footer class="site-footer">
  <div class="wrap">
    <div class="grid">
      <div>
        <a class="brand" href="{{ '/' | url }}">
          <span class="brand__logo"><img src="{{ '/assets/img/brand/logo.svg' | url }}" alt="" width="56" height="64"></span>
          <span class="brand__name">{{ site.name }}</span>
        </a>
        <p class="soft" style="color: var(--on-dark-soft)">{{ site.team }}. A program of the {{ site.longName }}.</p>
        {% if site.ein %}<p class="soft" style="color: var(--on-dark-soft)">The {{ site.longName }} is a <span style="white-space: nowrap">{{ site.nonprofitStatus }}</span>. <span style="white-space: nowrap">EIN {{ site.ein }}</span>.</p>{% endif %}
        <address>
          {{ site.address.street }}<br>
          {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}
        </address>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="{{ '/join/' | url }}">Join the team</a></li>
        </ul>
      </div>
      <div>
        <h2>Get in touch</h2>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          {% if site.phone %}<li><a href="tel:{{ site.phone | replace(' ', '') | replace('(', '') | replace(')', '') | replace('-', '') }}">{{ site.phone }}</a></li>{% endif %}
          {% for s in site.social %}<li><a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.label }}</a></li>{% endfor %}
        </ul>
      </div>
    </div>
    <p class="fine">&copy; {{ buildYear }} {{ site.longName }}. FIRST&reg; is a registered trademark of For Inspiration and Recognition of Science and Technology (FIRST). This website is not affiliated with FIRST.</p>
  </div>
</footer>
