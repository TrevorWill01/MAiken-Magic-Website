---
title: ""
permalink: /
---
<section class="hero">
  <div class="wrap hero__grid">
   <div class="hero__copy">
    <h1>Real robots, built by students from the CSRA.</h1>
    <p class="lead">{{ site.name }} is {{ site.team }}. Students in grades 8 to 12 from across {{ site.region }} meet at {{ site.school }} to design, machine, program, and promote a competition robot.</p>
    <div class="btn-row">
      <a class="btn btn--leaf" href="{{ '/join/' | url }}">Join the team</a>
      <a class="btn btn--line" href="{{ '/sponsors/' | url }}">Sponsor the team</a>
    </div>
   </div>
   {% if site.heroImage %}
   <div class="hero__art">
    <img src="{{ ('/assets/img/robots/' + site.heroImage.file) | url }}" alt="{{ site.heroImage.alt }}" width="{{ site.heroImage.width }}" height="{{ site.heroImage.height }}" fetchpriority="high">
   </div>
   {% endif %}
  </div>
</section>
<div class="teeth teeth--moss" aria-hidden="true"></div>

{% if site.homePhoto %}
<section class="band home-photo">
  <div class="wrap">
    <img src="{{ ('/assets/img/photos/' + site.homePhoto.file) | url }}" alt="{{ site.homePhoto.alt }}" width="{{ site.homePhoto.width }}" height="{{ site.homePhoto.height }}" loading="lazy">
  </div>
</section>
{% endif %}

<section class="band">
  <div class="wrap split">
    <div class="split__head">
      <h2 id="take-part">Ways to take part</h2>
      <p>Pick the program that fits your student's age and interests. All of them are hands-on.</p>
    </div>
    <ul class="rows">
      {% for p in programs %}
      <li>
        <h3>{{ p.name }}</h3>
        <p class="meta">{{ p.who }}</p>
        <p>{{ p.blurb }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="band band--fog2">
  <div class="wrap">
    <h2 id="subteams">Everyone on the team has a job</h2>
    <p class="soft" style="margin-top: 1rem; margin-bottom: 2.5rem;">A robot team needs more than builders. These are the five subteams.</p>
    <table class="parts">
      <thead>
        <tr><th scope="col">Subteam</th><th scope="col">What students do</th></tr>
      </thead>
      <tbody>
        {% for s in subteams %}
        <tr>
          <th scope="row">{{ s.name }}{% if s.also %}<span class="also">{{ s.also }}</span>{% endif %}</th>
          <td>{{ s.does }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{% set next = events | upcomingEvents %}
<section class="band band--black">
  <div class="wrap split">
    <div class="split__head">
      <h2>On the calendar</h2>
      <p>Where you can find the team next.</p>
    </div>
    <div>
      {% if next.length %}
      <ul class="agenda">
        {% for e in next | batch(3) | first %}
        <li>
          <time datetime="{{ e.start }}">{{ e.start | dateRange(e.end) }}</time>
          <div>
            <h3>{{ e.name }}</h3>
            <p class="detail">{{ e.type }}{% if e.location %}, {{ e.location }}{% endif %}</p>
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="empty">
        <h3>Nothing scheduled right now</h3>
        <p>New dates appear here as soon as we confirm them.</p>
      </div>
      {% endif %}
      <div class="btn-row"><a class="btn btn--line" href="{{ '/events/' | url }}">See all events</a></div>
    </div>
  </div>
</section>
<div class="teeth teeth--black-on-moss" aria-hidden="true"></div>

<section class="band band--moss">
  <div class="wrap split">
    <div class="split__head">
      <h2>Back the team</h2>
      <p>Sponsorship pays for parts, tools, event registration, and travel. Eight giving levels, named for the ranks of a wizard's career.</p>
      <div class="btn-row">
        <a class="btn btn--leaf" href="{{ '/sponsors/' | url }}">See giving levels</a>
      </div>
    </div>
    <ul class="ladder">
      {% for t in sponsors.tiers | byMinDesc %}
      <li style="--rank: {{ loop.revindex }}">
        <span class="tier">{{ t.name }}</span>
        <span class="range">{{ t.range }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
<div class="teeth teeth--moss" aria-hidden="true"></div>

<section class="band cta">
  <div class="wrap">
    <h2>Start building with us</h2>
    <p>Students in grades 8 to 12 are welcome, and no experience is needed. Email us to find out how to get started.</p>
    <div class="btn-row">
      <a class="btn btn--moss" href="{{ '/join/' | url }}">How to join</a>
      <a class="btn btn--line" href="{{ links.ask }}">Ask a question</a>
    </div>
  </div>
</section>
