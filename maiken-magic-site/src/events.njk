---
title: Events
description: "Where to find Team 1102 at off-season competitions and open houses."
permalink: /events/
---
{% set next = events | upcomingEvents %}
{% set earlier = events | pastEvents %}
<section class="pagehead">
  <div class="wrap">
    <h1>Events</h1>
    <p>Competitions, open houses, and the places you can watch the robot run.</p>
  </div>
</section>
<div class="teeth teeth--moss" aria-hidden="true"></div>

<section class="band">
  <div class="wrap split">
    <div class="split__head">
      <h2>Coming up</h2>
    </div>
    <div>
      {% if next.length %}
      <ul class="agenda agenda--light">
        {% for e in next %}
        <li>
          <time datetime="{{ e.start }}">{{ e.start | dateRange(e.end) }}</time>
          <div>
            <h3>{% if e.url %}<a href="{{ e.url }}" rel="noopener" target="_blank">{{ e.name }}</a>{% else %}{{ e.name }}{% endif %}</h3>
            <p class="detail">{{ e.type }}{% if e.location %}, {{ e.location }}{% endif %}</p>
            {% if e.note %}<p class="detail">{{ e.note }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="empty">
        <h3>Nothing scheduled right now</h3>
        <p>New dates appear here as soon as we confirm them. Want to be told when they do? Email us and we will add you to the list.</p>
        <a class="btn btn--moss" href="{{ links.ask }}">Email the team</a>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if earlier.length %}
<section class="band band--fog2">
  <div class="wrap split">
    <div class="split__head">
      <h2>Earlier this season</h2>
    </div>
    <ul class="agenda agenda--light">
      {% for e in earlier %}
      <li>
        <time datetime="{{ e.start }}">{{ e.start | dateRange(e.end) }}</time>
        <div>
          <h3>{% if e.url %}<a href="{{ e.url }}" rel="noopener" target="_blank">{{ e.name }}</a>{% else %}{{ e.name }}{% endif %}</h3>
          <p class="detail">{{ e.type }}{% if e.location %}, {{ e.location }}{% endif %}</p>
          {% if e.note %}<p class="detail">{{ e.note }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
