<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ '/' | url }}">
      <span class="brand__logo"><img src="{{ '/assets/img/brand/logo.png' | url }}" alt="" width="52" height="52"></span>
      <span class="brand__name">{{ site.name }}</span>
      <span class="brand__team">Team {{ site.teamNumber }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        {% for item in site.nav %}
        <li><a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a class="btn btn--leaf" href="{{ '/join/' | url }}">Join the team</a>
    </nav>
  </div>
</header>
