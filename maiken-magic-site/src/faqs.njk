<section class="pagehead">
  <div class="wrap">
    <h1>Frequently asked questions</h1>
    <p>Quick answers for students, parents, and sponsors.</p>
  </div>
</section>
<div class="teeth teeth--moss" aria-hidden="true"></div>

<section class="band">
  <div class="wrap">
    <div class="faq">
      {% for f in faqs %}
      <details>
        <summary>{{ f.q }}</summary>
        <div class="answer"><p>{{ f.a }}</p></div>
      </details>
      {% endfor %}
    </div>
    <div class="btn-row">
      <a class="btn btn--moss" href="{{ links.ask }}">Ask something else</a>
    </div>
  </div>
</section>
