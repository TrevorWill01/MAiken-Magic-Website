{
  // Cloudflare builds every branch into a preview URL. This is an assets-only
  // Worker: no server code, it just serves whatever is in _site/.
  // The name must match the project name you give Cloudflare (see SETUP.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maiken-magic-website",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
