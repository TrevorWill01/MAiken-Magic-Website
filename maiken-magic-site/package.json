{
  "name": "maiken-magic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website for M'Aiken Magic, FIRST Robotics Competition Team 1102",
  "scripts": {
    "start": "eleventy --serve --quiet",
    "build": "eleventy",
    "build:preview": "eleventy && node scripts/mark-preview.mjs",
    "check": "eleventy && node scripts/check-links.mjs",
    "review": "eleventy && node scripts/review-shots.mjs",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
